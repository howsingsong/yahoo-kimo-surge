#!name=Yahoo 奇摩值每日簽到
#!desc=自動擷取 Yahoo Cookie，取得 Crumb 並執行每日奇摩值簽到
#!author=howsingsong

#!arguments=hour:0,minute:10,notify:true,capture_notify:true,debug:false
#!arguments-desc=可設定每日簽到時間、通知與除錯模式

[Script]

Yahoo 奇摩值 Cookie 擷取 = type=http-request,pattern=^https:\/\/loyalty\.media\.yahoo\.com\/api\/membership\/v2\/,script-path=https://raw.githubusercontent.com/howsingsong/yahoo-kimo-surge/main/yahoo_capture.js,argument="capture_notify={{{capture_notify}}}&debug={{{debug}}}"

Yahoo 奇摩值每日簽到 = type=cron,cronexp="{{{minute}}} {{{hour}}} * * *",script-path=https://raw.githubusercontent.com/howsingsong/yahoo-kimo-surge/main/yahoo_checkin.js,argument="notify={{{notify}}}&debug={{{debug}}}",wake-system=true,timeout=30

[MITM]

hostname = %APPEND% loyalty.media.yahoo.com
